# Browser key from Google Cloud (restrict by HTTP referrer + API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (JavaScript, vector) from Google Maps Platform > Map Management
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Where quote requests are emailed (server-only)
QUOTE_TO_EMAIL=
# Resend API key (resend.com > API Keys) used to email quote requests (server-only)
RESEND_API_KEY=
# Optional sender once 209adus.com is verified in Resend, e.g. Valley ADU Studio <leads@209adus.com>
QUOTE_FROM_EMAIL=
